
# Ignore everything at the repository root
/*

# Keep main folders and Git configuration
!/BareMetal/
!/Arduino/
!/CMSIS/
!/HAL/
!/.gitignore

# Ignore STM32CubeIDE generated folders
**/Debug/
**/Release/
**/.settings/
**/.metadata/

# Ignore build output files
**/*.elf
**/*.bin
**/*.hex
**/*.map
**/*.list
**/*.su
**/*.d
**/*.o
**/*.cyclo

# Ignore generated IDE indexes and binaries
**/Binaries/
**/Includes/
